<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>You have IPv6</title>
<style>
:root {
  --bg: #0b1020;
  --card: #16203f;
  --line: #26335c;
  --text: #e6ecff;
  --muted: #93a0c8;
  --ok: #22c55e;
  --radius: 16px;
}
@media (prefers-color-scheme: light) {
  :root {
    --bg: #f4f6fb; --card: #fff; --line: #dbe2f0; --text: #1a2340; --muted: #5b6890;
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font: 15px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, Ubuntu, sans-serif;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
}
.wrap { max-width: 760px; width: 100%; }

.hero {
  background: linear-gradient(135deg, #12331f, var(--card));
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 40px 32px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
@media (prefers-color-scheme: light) { .hero { background: linear-gradient(135deg, #e8f7ee, var(--card)); } }
.hero .glow { position: absolute; left: 50%; top: -120px; transform: translateX(-50%); width: 320px; height: 320px; border-radius: 50%; background: var(--ok); filter: blur(90px); opacity: .25; }
.hero .check { font-size: 56px; line-height: 1; }
.hero h1 { font-size: clamp(28px, 6vw, 44px); margin: 12px 0 0; font-weight: 800; color: var(--ok); }
.hero p.sub { color: var(--muted); margin: 10px auto 0; max-width: 520px; }
.addr {
  margin: 26px auto 0;
  display: inline-block;
  background: rgba(0,0,0,.25);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px 22px;
  max-width: 100%;
}
@media (prefers-color-scheme: light) { .addr { background: rgba(0,0,0,.04); } }
.addr .k { font-size: 12px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); font-weight: 600; }
.addr .v { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: clamp(16px, 3.4vw, 24px); font-weight: 700; margin-top: 6px; word-break: break-all; }
</style>
</head>
<body>
<div class="wrap">
  <main>
    <section class="hero">
      <div class="glow"></div>
      <div class="check">&#127881;</div>
      <h1>You have IPv6!</h1>
      <p class="sub">You reached this page over IPv6. It is only reachable over IPv6, so if you can see this, IPv6 works end to end.</p>
      <div class="addr">
        <div class="k">Your IP address</div>
        <div class="v">{{ .Client.IP }}{{ if ne .Client.Family "ipv6" }} ({{ .Client.Family }}){{ end }}</div>
      </div>
    </section>
  </main>
</div>
</body>
</html>